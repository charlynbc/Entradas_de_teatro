# Variables de entorno para desarrollo en Codespaces (snapshot 02/12)

# Puerto del servidor
PORT=3000

# URL de conexión a PostgreSQL
# Usando Docker local: usuario y DB "teatro"
DATABASE_URL=postgres://postgres:postgres@localhost:5432/teatro

# Secret para JWT (CAMBIAR EN PRODUCCIÓN - Mínimo 32 caracteres aleatorios)
# Generar en producción: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar_en_produccion_minimo_32_caracteres_aleatorios

# URL base (opcional)
BASE_URL=http://localhost:3000

# Entorno
# development = caché deshabilitado, logs verbose
# production = caché habilitado, logs mínimos, error handling seguro
NODE_ENV=development

# Frontend URL para CORS (en producción: https://tu-dominio.com)
FRONTEND_URL=http://localhost:5173
